# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
# Profile opcional (padrão: default / variáveis de ambiente)
AWS_PROFILE=

# ── Banco alvo ───────────────────────────────────────────────────────────────
DB_NAME=money
DB_USER=postgres
# Deixe vazio para buscar no Secrets Manager ou pedir via prompt (recomendado)
DB_PASSWORD=
DB_PORT=5432
MAINTENANCE_DB=postgres

# ── Secrets Manager ──────────────────────────────────────────────────────────
# Segredo existente: somente usuário/senha são lidos (o host NUNCA é usado
# para decidir a instância alvo). Exemplo do formato:
#   arn:aws:secretsmanager:us-east-1:123456789012:secret:meu-segredo-rds-AbCdEf
DB_SECRET_ARN=
# Segredo próprio criado/atualizado com --publish-secret
PUBLISH_SECRET_NAME=folheia/db/money

# ── Instâncias ───────────────────────────────────────────────────────────────
# Modo --create-new (padrão do critério de aceite do PRD)
PRIMARY_INSTANCE_ID=folheia-money-primary
# Endpoint da primária existente (usado com --adopt-existing). Exemplo:
#   minha-instancia.abcdefghijkl.us-east-1.rds.amazonaws.com
PRIMARY_ENDPOINT=
REPLICA_INSTANCE_ID=folheia-money-replica
INSTANCE_CLASS=db.t4g.micro
# Vazio = mesma AZ da primária
REPLICA_AZ=
ALLOCATED_STORAGE=20
BACKUP_RETENTION=1

# ── Rede ─────────────────────────────────────────────────────────────────────
ALLOWED_CIDR=0.0.0.0/0
VPC_CIDR=10.0.0.0/16
DB_SUBNET_GROUP=folheia-replication-subnet-group

# ── TLS ──────────────────────────────────────────────────────────────────────
SSL_MODE=verify-full
SSL_ROOT_CERT=infra/certs/global-bundle.pem

# ── Teste de replicação ──────────────────────────────────────────────────────
ROWS=1000
